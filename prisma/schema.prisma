// ======================================================
// ROOT PRISMA SETUP (Prisma 7 compatible)
// ======================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum Gender {
  MALE
  FEMALE
  BINARY
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum Specialty {
  CARDIOLOGIST
  DERMATOLOGIST
  PEDIATRICIAN
  NEUROLOGIST
  NEPHROLOGIST
  GASTROENTEROLOGIST
  ENDOCRINOLOGIST
  PULMONOLOGIST
  ONCOLOGIST
  ORTHOPEDIC
  OPHTHALMOLOGIST
  OTOLARYNGOLOGIST
  UROLOGIST
  RHEUMATOLOGIST
  PSYCHIATRIST
  PSYCHOLOGIST
  GENERAL_PHYSICIAN
  GENERAL_SURGEON
  RADIOLOGIST
  PATHOLOGIST
  HEMATOLOGIST
  DENTIST
  GYNECOLOGIST
  OBSTETRICIAN
  PLASTIC_SURGEON
  VASCULAR_SURGEON
  CARDIOTHORACIC_SURGEON
  DERMATOSURGEON
  INFECTIOUS_DISEASE_SPECIALIST
  IMMUNOLOGIST
  ANESTHESIOLOGIST
  EMERGENCY_MEDICINE
  SPORTS_MEDICINE
  PAIN_MEDICINE
  CRITICAL_CARE
  PHYSIOTHERAPIST
  NUTRITIONIST
}

enum Qualification {
  MBBS
  BDS
  BPT
  BHMS
  BAMS
  MD
  MS
  DNB
  MDS
  DM
  MCH
  MPH
  MBA_HM
  PHD
  DO
  FELLOWSHIP
  PGD
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  UNAVAILABLE
  CANCELLED
  ON_LEAVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  EXPIRED
}

enum PaymentMethod {
  OFFLINE
  ONLINE
}

enum MedicalDocumentType {
  LAB_REPORT
  PRESCRIPTION
  RADIOLOGY_SCAN
  DISCHARGE_SUMMARY
  MEDICAL_CERTIFICATE
  VACCINATION_RECORD
  OTHER
}

enum MedicalDocumentProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  READY
  FAILED
}

// ======================================================
// USER, ADMIN, DOCTOR, PATIENT MODELS
// ======================================================

model User {
  id       String @id @default(cuid())
  email    String @unique
  phoneNo  String
  name     String
  password String
  age      Int

  gender Gender @default(MALE)
  role   Role   @default(PATIENT)

  address String

  pinCode Int

  
  profileImageUrl String?
  emailVerified   Boolean        @default(false)
  isActive        Boolean        @default(true)
  admin           Admin?
  doctor          Doctor?
  patient         Patient?
  otp             Otp[]
  accessLogs      AccessLog[]
  auditLogs       AuditLog[]
  chatMessages    ChatMessages[]
  payments        Payment[]
  checkouts       Checkout[]
  notifications   Notification[]
  
  updatedAt       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  location        Location       @relation(fields: [pinCode], references: [pincode])
  bankAccounts    BankAccount[]
}

model Location {
  pincode Int    @id @unique
  city    String
  state   String

  user User[]
}

model Admin {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  managerId String?
  manager   Admin?  @relation("AdminHierarchy", fields: [managerId], references: [id], onDelete: Cascade)
  subAdmins Admin[] @relation("AdminHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([managerId])
}

model Doctor {
  id         String    @id @default(cuid())
  userId     String    @unique
  specialty  Specialty
  experience Int       @default(0)
  fees      Int     @default(0)
  doctorBio String?
  balance   Int     @default(0) 
  // A one-time saved practice location. Patient locations are never stored.
  latitude  Float?  @db.DoublePrecision
  longitude Float?  @db.DoublePrecision

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves           Leave[]
  schedule         Schedule?
  patientRelations DoctorPatientRelation[]
  appointments     Appointment[]
  slots            Slot[]
  checkouts        Checkout[]
  comments         Comment[]
  ratings          Rating[]
  withdrawals      Withdrawal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorQualifications DoctorQualification[]
  medicalAiConversations MedicalAiConversation[]

  @@index([latitude, longitude])
}

model DoctorQualification {
  id            String        @id @default(cuid())
  doctorId      String
  doctor        Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  qualification Qualification

  @@unique([doctorId, qualification])
}

model Patient {
  id     String @id @default(cuid())
  userId String @unique

  medicalHistory     String @default("")
  allergies          String @default("")
  currentMedications String @default("")
  
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorRelations DoctorPatientRelation[]
  appointments    Appointment[]
  checkouts       Checkout[]
  comments        Comment[]
  ratings         Rating[]
  medicalDocuments MedicalDocument[]
  medicalAiConversations MedicalAiConversation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalDocument {
  id               String              @id @default(cuid())

  patientId        String
  patient          Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  title            String
  type             MedicalDocumentType

  fileName         String
  mimeType         String
  fileSize         Int

  storagePath      String              @unique

  reportDate       DateTime
  hospitalOrDoctor String?
  notes            String?

  processingStatus MedicalDocumentProcessingStatus @default(PENDING)
  processingError  String?
  processedAt      DateTime?

  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([patientId])
  @@index([patientId, reportDate])
  @@index([patientId, type])
  @@index([patientId, processingStatus])
}

// ======================================================
// USER MODULE (Notification)
// ======================================================

model Notification {
  id          String    @id @default(cuid())
  userId      String
  message     String
  actionHref  String?
  actionLabel String?
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead  Boolean   @default(false)
  status  String    @default("UNREAD")
  readAt  DateTime?
  eventId     String?

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
}

// ======================================================
// DOCTOR MODULE (Leave, Schedule, Availability, Slot, Appointment)
// ======================================================

model Leave {
  id       String @id @default(cuid())
  doctorId String

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  reason    String
  startDate DateTime
  endDate   DateTime
  applyAt   DateTime @default(now())

  @@unique([doctorId, startDate, endDate])
  @@index([doctorId])
  @@index([startDate, endDate])
}

model Schedule {
  id             String @id @default(cuid())
  doctorId       String @unique
  weeklySchedule Json

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@index([doctorId])
}

model Slot {
  id              String     @id @default(cuid())
  doctorId        String
  date            DateTime   @db.Date
  startTime       DateTime
  endTime         DateTime
  status          SlotStatus @default(AVAILABLE)
  heldByPatientId String?
  heldAt          DateTime?
  holdToken       String?
  holdExpiresAt   DateTime?

  appointments Appointment[]
  checkouts    Checkout[]

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([doctorId, date, startTime])
  @@index([doctorId, date, status])
  @@index([startTime, status])
  @@index([heldByPatientId])
  @@index([holdExpiresAt])
}

model Appointment {
  id                   String            @id @default(cuid())
  doctorId             String
  patientId            String
  slotId               String
  paymentId            String?           @unique
  status               AppointmentStatus @default(PENDING)
  paymentMethod        PaymentMethod     @default(OFFLINE)
  transactionId        String?
  notes                String?
  bookedAt             DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  slot                 Slot              @relation(fields: [slotId], references: [id])
  payment              Payment?          @relation(fields: [paymentId], references: [id])
  checkout             Checkout?
  doctor               Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient              Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  isAppointmentOffline Boolean           @default(true)

  @@index([doctorId, patientId])
  @@index([slotId])
  @@index([status])
}

// ======================================================
// DOCTOR–PATIENT RELATION MODEL / CHAT MODEL
// ======================================================

model DoctorPatientRelation {
  id             String @id @default(cuid())
  doctorsUserId  String
  patientsUserId String

  chatMessages ChatMessages[]

  doctor  Doctor  @relation(fields: [doctorsUserId], references: [userId], onDelete: Cascade)
  patient Patient @relation(fields: [patientsUserId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorsUserId, patientsUserId])
  @@index([patientsUserId])
  @@index([doctorsUserId])
}

model ChatMessages {
  id String @id @default(cuid())

  doctorPatientRelationId String
  doctorPatientRelation   DoctorPatientRelation @relation(fields: [doctorPatientRelationId], references: [id], onDelete: Cascade)

  text            String
  senderId        String
  sender          User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientMessageId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorPatientRelationId, createdAt])
  @@index([senderId])
}

model Payment {
  id             String   @id @default(cuid())
  idempotencyKey String?  @unique
  amount         Int
  currency       String   @default("INR")
  userId         String
  doctorId       String?
  slotId         String?
  holdToken      String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  capturedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  appointment       Appointment?
  checkout          Checkout?
  refunds           Refund[]
  webhookEvents     WebhookEvent[]

  @@index([userId, status])
  @@index([slotId])
  @@index([razorpayPaymentId])
}

enum CheckoutStatus {
  PENDING_ORDER
  READY_FOR_PAYMENT
  CONFIRMED
  EXPIRED
  FAILED
  UNRESOLVED
}

model Checkout {
  id              String         @id @default(cuid())
  idempotencyKey  String         @unique
  userId          String
  patientId       String
  doctorId        String
  slotId          String
  holdToken       String
  paymentMethod   PaymentMethod  @default(ONLINE)
  amount          Int            // Immutable amount in paise
  currency        String         @default("INR")
  status          CheckoutStatus @default(PENDING_ORDER)

  razorpayOrderId String?        @unique
  expiresAt       DateTime

  paymentId       String?        @unique
  appointmentId   String?        @unique

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slot            Slot           @relation(fields: [slotId], references: [id], onDelete: Cascade)
  payment         Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  confirmedAt     DateTime?

  @@index([userId, status])
  @@index([doctorId, slotId])
  @@index([expiresAt, status])
  @@index([razorpayOrderId])
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount           Int          // Amount in paise
  currency         String       @default("INR")
  reason           String
  status           RefundStatus @default(PENDING)
  idempotencyKey   String       @unique
  razorpayRefundId String?      @unique
  failureReason    String?
  attempts         Int          @default(0)
  lastAttemptAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  processedAt      DateTime?

  @@index([paymentId])
  @@index([status])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model WebhookEvent {
  id              String             @id @default(cuid())
  providerEventId String             @unique
  eventType       String
  paymentId       String?
  payment         Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status          WebhookEventStatus @default(RECEIVED)
  payload         Json
  processingError String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?

  @@index([status])
  @@index([eventType])
  @@index([paymentId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model NotificationOutbox {
  id            String       @id @default(cuid())
  eventId       String       @unique
  channel       String       // e.g. "SOCKET_NOTIFICATION", "SOCKET_APPOINTMENT_REQUEST", "SOCKET_APPOINTMENT_STATUS"
  targetUserId  String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime     @default(now())
  deliveredAt   DateTime?

  @@index([status, createdAt])
  @@index([targetUserId])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Withdrawal {
  id       String @id @default(cuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  amount   Int // Amount in paise
  currency String           @default("INR")
  status   WithdrawalStatus @default(PENDING)

  // Razorpay payout details (if using Razorpay for payouts)
  razorpayPayoutId String?
  failureReason    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([doctorId])
  @@index([status])
}

model BankAccount {
  id                    String @id @default(cuid())
  userId                String
  user                  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountNumber     String @unique
  bankIFSC              String
  bankAccountHolderName String
  bankName              String
}

model Otp {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ======================================================
// LOG MODELS
// ======================================================

model AccessLog {
  id       String  @id @default(cuid())
  userId   String?
  targetId String?
  action   String
  tag      String? @default("SYSTEM") // e.g. AUTH, APPOINTMENT, ADMIN

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([targetId])
  @@index([tag])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id       String  @id @default(cuid())
  userId   String?
  action   String
  tag      String? @default("SYSTEM") // e.g. AUTH, SECURITY, ONBOARDING
  metadata Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tag])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ======================================================
// DOCTOR REVIEW/COMMENT SYSTEM
// ======================================================

model Rating {
  id       String @id @default(cuid())
  doctorId String
  patientId   String
  rating   Int // 1-5 stars

  // Relations
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, patientId]) // One rating per user per doctor
  @@index([doctorId])
  @@index([patientId])
}

model Comment {
  id       String @id @default(cuid())
  doctorId String
  patientId   String
  text     String // Comment text

  // Relations
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@index([patientId])
  @@index([createdAt])
}

// ======================================================
// MEDICAL AI CHAT MODELS
// ======================================================

enum MedicalAiMessageRole {
  USER
  ASSISTANT
}

enum MedicalAiMessageStatus {
  COMPLETE
  FAILED
}

model MedicalAiConversation {
  id        String   @id @default(cuid())
  doctorId  String
  patientId String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor   Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient  Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages MedicalAiMessage[]

  @@index([doctorId, patientId])
  @@index([doctorId, updatedAt])
}

model MedicalAiMessage {
  id             String                 @id @default(cuid())
  conversationId String
  role           MedicalAiMessageRole
  content        String
  citations      Json?
  status         MedicalAiMessageStatus @default(COMPLETE)
  createdAt      DateTime               @default(now())

  conversation MedicalAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}


// ======================================================
// ROOT PRISMA SETUP (Prisma 7 compatible)
// ======================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum Gender {
  MALE
  FEMALE
  BINARY
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum Specialty {
  CARDIOLOGIST
  DERMATOLOGIST
  PEDIATRICIAN
  NEUROLOGIST
  NEPHROLOGIST
  GASTROENTEROLOGIST
  ENDOCRINOLOGIST
  PULMONOLOGIST
  ONCOLOGIST
  ORTHOPEDIC
  OPHTHALMOLOGIST
  OTOLARYNGOLOGIST
  UROLOGIST
  RHEUMATOLOGIST
  PSYCHIATRIST
  PSYCHOLOGIST
  GENERAL_PHYSICIAN
  GENERAL_SURGEON
  RADIOLOGIST
  PATHOLOGIST
  HEMATOLOGIST
  DENTIST
  GYNECOLOGIST
  OBSTETRICIAN
  PLASTIC_SURGEON
  VASCULAR_SURGEON
  CARDIOTHORACIC_SURGEON
  DERMATOSURGEON
  INFECTIOUS_DISEASE_SPECIALIST
  IMMUNOLOGIST
  ANESTHESIOLOGIST
  EMERGENCY_MEDICINE
  SPORTS_MEDICINE
  PAIN_MEDICINE
  CRITICAL_CARE
  PHYSIOTHERAPIST
  NUTRITIONIST
}

enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AgentExecutionStatus {
  NOT_STARTED
  EXECUTING
  COMPLETED
  FAILED
}

enum AgentActionRiskLevel {
  LOW_AUTONOMOUS
  MEDIUM_HUMAN_APPROVAL
  HIGH_CLINICAL_RESTRICTED
}

enum MedicalPipelineStatus {
  PENDING
  QUEUED
  RUNNING
  PARTIAL
  COMPLETED
  RETRYABLE
  FAILED
  REVOKED
}

enum AgentThreadStatus {
  ACTIVE
  ARCHIVED
  REDACTED
}

enum AgentMessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AgentMessageStatus {
  PENDING
  COMPLETED
  FAILED
  REDACTED
}


enum Qualification {
  MBBS
  BDS
  BPT
  BHMS
  BAMS
  MD
  MS
  DNB
  MDS
  DM
  MCH
  MPH
  MBA_HM
  PHD
  DO
  FELLOWSHIP
  PGD
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  UNAVAILABLE
  CANCELLED
  ON_LEAVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  EXPIRED
}

enum PaymentMethod {
  OFFLINE
  ONLINE
}

enum MedicalDocumentType {
  LAB_REPORT
  PRESCRIPTION
  RADIOLOGY_SCAN
  DISCHARGE_SUMMARY
  MEDICAL_CERTIFICATE
  VACCINATION_RECORD
  OTHER
}

enum MedicalDocumentProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  READY
  FAILED
}

// ======================================================
// USER, ADMIN, DOCTOR, PATIENT MODELS
// ======================================================

model User {
  id       String @id @default(cuid())
  email    String @unique
  phoneNo  String
  name     String
  password String
  age      Int

  gender Gender @default(MALE)
  role   Role   @default(PATIENT)

  address String

  pinCode Int

  
  profileImageUrl String?
  emailVerified   Boolean        @default(false)
  isActive        Boolean        @default(true)
  admin           Admin?
  doctor          Doctor?
  patient         Patient?
  otp             Otp[]
  accessLogs      AccessLog[]
  auditLogs       AuditLog[]
  chatMessages    ChatMessages[]
  payments        Payment[]
  checkouts       Checkout[]
  notifications   Notification[]
  agentThreadsOwned       AgentThread[]        @relation("AgentThreadOwner")
  agentApprovalsRequested AgentApproval[]      @relation("AgentApprovalRequester")
  agentApprovalsDecided   AgentApproval[]      @relation("AgentApprovalDecider")
  medicalGrantsCreated    MedicalAccessGrant[] @relation("MedicalGrantCreator")
  
  updatedAt       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  location        Location       @relation(fields: [pinCode], references: [pincode])
  bankAccounts    BankAccount[]
}

model Location {
  pincode Int    @id @unique
  city    String
  state   String

  user User[]
}

model Admin {
  id     String @id @default(cuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  managerId String?
  manager   Admin?  @relation("AdminHierarchy", fields: [managerId], references: [id], onDelete: Cascade)
  subAdmins Admin[] @relation("AdminHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([managerId])
}

model Doctor {
  isReleaseFixture Boolean @default(false)
  id         String    @id @default(cuid())
  userId     String    @unique
  specialty  Specialty
  experience Int       @default(0)
  fees      Int     @default(0)
  doctorBio String?
  balance   Int     @default(0) 
  // A one-time saved practice location. Patient locations are never stored.
  latitude  Float?  @db.DoublePrecision
  longitude Float?  @db.DoublePrecision

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves           Leave[]
  schedule         Schedule?
  patientRelations DoctorPatientRelation[]
  appointments     Appointment[]
  slots            Slot[]
  checkouts        Checkout[]
  comments         Comment[]
  ratings          Rating[]
  withdrawals      Withdrawal[]
  agentThreads        AgentThread[]
  medicalAccessGrants MedicalAccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorQualifications DoctorQualification[]


  @@index([latitude, longitude])
}

model DoctorQualification {
  id            String        @id @default(cuid())
  doctorId      String
  doctor        Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  qualification Qualification

  @@unique([doctorId, qualification])
}

model Patient {
  id     String @id @default(cuid())
  userId String @unique

  medicalHistory     String @default("")
  allergies          String @default("")
  currentMedications String @default("")
  
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorRelations DoctorPatientRelation[]
  appointments    Appointment[]
  checkouts       Checkout[]
  comments        Comment[]
  ratings         Rating[]
  medicalDocuments MedicalDocument[]
  agentThreads          AgentThread[]
  medicalAccessGrants   MedicalAccessGrant[]
  extractedObservations MedicalObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalDocument {
  id               String              @id @default(cuid())

  patientId        String
  patient          Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  title            String
  type             MedicalDocumentType

  fileName         String
  mimeType         String
  fileSize         Int

  storagePath      String              @unique

  reportDate       DateTime
  hospitalOrDoctor String?
  notes            String?

  processingStatus MedicalDocumentProcessingStatus @default(PENDING)
  processingError  String?
  processedAt      DateTime?

  versions        MedicalDocumentVersion[]
  ingestionJobs   MedicalIngestionJob[]
  accessGrants    MedicalAccessGrant[]
  cleanupRequests MedicalDocumentCleanup[]

  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([patientId])
  @@index([patientId, reportDate])
  @@index([patientId, type])
  @@index([patientId, processingStatus])
}

// ======================================================
// USER MODULE (Notification)
// ======================================================

model Notification {
  id          String    @id @default(cuid())
  userId      String
  message     String
  actionHref  String?
  actionLabel String?
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead  Boolean   @default(false)
  status  String    @default("UNREAD")
  readAt  DateTime?
  eventId     String?

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
}

// ======================================================
// DOCTOR MODULE (Leave, Schedule, Availability, Slot, Appointment)
// ======================================================

model Leave {
  id       String @id @default(cuid())
  doctorId String

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  reason    String
  startDate DateTime
  endDate   DateTime
  applyAt   DateTime @default(now())

  @@unique([doctorId, startDate, endDate])
  @@index([doctorId])
  @@index([startDate, endDate])
}

model Schedule {
  id             String @id @default(cuid())
  doctorId       String @unique
  weeklySchedule Json

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@index([doctorId])
}

model Slot {
  id              String     @id @default(cuid())
  doctorId        String
  date            DateTime   @db.Date
  startTime       DateTime
  endTime         DateTime
  status          SlotStatus @default(AVAILABLE)
  heldByPatientId String?
  heldAt          DateTime?
  holdToken       String?
  holdExpiresAt   DateTime?

  appointments Appointment[]
  checkouts    Checkout[]

  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([doctorId, date, startTime])
  @@index([doctorId, date, status])
  @@index([startTime, status])
  @@index([heldByPatientId])
  @@index([holdExpiresAt])
}

model Appointment {
  id                   String            @id @default(cuid())
  doctorId             String
  patientId            String
  slotId               String
  paymentId            String?           @unique
  status               AppointmentStatus @default(PENDING)
  paymentMethod        PaymentMethod     @default(OFFLINE)
  transactionId        String?
  notes                String?
  bookedAt             DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  slot                 Slot              @relation(fields: [slotId], references: [id])
  payment              Payment?          @relation(fields: [paymentId], references: [id])
  checkout             Checkout?
  doctor               Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient              Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  isAppointmentOffline Boolean           @default(true)

  @@index([doctorId, patientId])
  @@index([slotId])
  @@index([status])
}

// ======================================================
// DOCTOR–PATIENT RELATION MODEL / CHAT MODEL
// ======================================================

model DoctorPatientRelation {
  id             String @id @default(cuid())
  doctorsUserId  String
  patientsUserId String

  doctorLastReadAt  DateTime?
  patientLastReadAt DateTime?

  chatMessages ChatMessages[]

  doctor  Doctor  @relation(fields: [doctorsUserId], references: [userId], onDelete: Cascade)
  patient Patient @relation(fields: [patientsUserId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorsUserId, patientsUserId])
  @@index([patientsUserId])
  @@index([doctorsUserId])
}

model ChatMessages {
  id String @id @default(cuid())

  doctorPatientRelationId String
  doctorPatientRelation   DoctorPatientRelation @relation(fields: [doctorPatientRelationId], references: [id], onDelete: Cascade)

  text            String
  senderId        String
  sender          User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientMessageId String? @unique

  isRead          Boolean   @default(false)
  readAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorPatientRelationId, createdAt])
  @@index([doctorPatientRelationId, isRead])
  @@index([senderId])
}

model Payment {
  id             String   @id @default(cuid())
  idempotencyKey String?  @unique
  amount         Int
  currency       String   @default("INR")
  userId         String
  doctorId       String?
  slotId         String?
  holdToken      String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  capturedAt        DateTime?
  leaseExpiresAt    DateTime?
  leaseOwner        String?
  attempts          Int      @default(0)
  nextAttemptAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  appointment       Appointment?
  checkout          Checkout?
  refunds           Refund[]
  webhookEvents     WebhookEvent[]

  @@index([userId, status])
  @@index([slotId])
  @@index([razorpayPaymentId])
  @@index([status, nextAttemptAt])
}

enum CheckoutStatus {
  PENDING_ORDER
  READY_FOR_PAYMENT
  CONFIRMED
  EXPIRED
  FAILED
  UNRESOLVED
  MANUAL_REVIEW
}

model Checkout {
  id              String         @id @default(cuid())
  idempotencyKey  String         @unique
  userId          String
  patientId       String
  doctorId        String
  slotId          String
  holdToken       String
  paymentMethod   PaymentMethod  @default(ONLINE)
  amount          Int            // Immutable amount in paise
  currency        String         @default("INR")
  status          CheckoutStatus @default(PENDING_ORDER)

  razorpayOrderId   String?        @unique
  providerReference String?
  expiresAt         DateTime

  paymentId       String?        @unique
  appointmentId   String?        @unique

  // Processing, lease & reconciliation tracking
  processingStartedAt DateTime?
  leaseExpiresAt      DateTime?
  leaseOwner          String?
  attempts            Int            @default(0)
  lastAttemptAt       DateTime?
  nextAttemptAt       DateTime?
  lastError           String?

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slot            Slot           @relation(fields: [slotId], references: [id], onDelete: Cascade)
  payment         Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  confirmedAt     DateTime?

  @@index([userId, status])
  @@index([doctorId, slotId])
  @@index([expiresAt, status])
  @@index([razorpayOrderId])
  @@index([providerReference])
  @@index([status, nextAttemptAt])
}

enum RefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount           Int          // Amount in paise
  currency         String       @default("INR")
  reason           String
  status           RefundStatus @default(PENDING)
  idempotencyKey   String       @unique
  razorpayRefundId String?      @unique
  failureReason    String?
  attempts         Int          @default(0)
  lastAttemptAt    DateTime?
  leaseExpiresAt   DateTime?
  leaseOwner       String?
  nextAttemptAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  processedAt      DateTime?

  @@index([paymentId])
  @@index([status])
  @@index([status, nextAttemptAt])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model WebhookEvent {
  id                  String             @id @default(cuid())
  providerEventId     String             @unique
  eventType           String
  paymentId           String?
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status              WebhookEventStatus @default(RECEIVED)
  payload             Json
  processingError     String?
  processingStartedAt DateTime?
  leaseExpiresAt      DateTime?
  leaseOwner          String?
  attempts            Int                @default(0)
  nextAttemptAt       DateTime?
  receivedAt          DateTime           @default(now())
  processedAt         DateTime?

  @@index([status])
  @@index([eventType])
  @@index([paymentId])
  @@index([status, nextAttemptAt])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model NotificationOutbox {
  id                  String       @id @default(cuid())
  eventId             String       @unique
  channel             String       // e.g. "SOCKET_NOTIFICATION", "SOCKET_APPOINTMENT_REQUEST", "SOCKET_APPOINTMENT_STATUS"
  targetUserId        String
  payload             Json
  status              OutboxStatus @default(PENDING)
  attempts            Int          @default(0)
  lastError           String?
  lastAttemptAt       DateTime?
  processingStartedAt DateTime?
  leaseExpiresAt      DateTime?
  leaseOwner          String?
  nextAttemptAt       DateTime?
  createdAt           DateTime     @default(now())
  deliveredAt         DateTime?

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([status, nextAttemptAt])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Withdrawal {
  id       String @id @default(cuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  amount   Int // Amount in paise
  currency String           @default("INR")
  status   WithdrawalStatus @default(PENDING)

  // Razorpay payout details (if using Razorpay for payouts)
  razorpayPayoutId String?
  failureReason    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([doctorId])
  @@index([status])
}

model BankAccount {
  id                    String @id @default(cuid())
  userId                String
  user                  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountNumber     String @unique
  bankIFSC              String
  bankAccountHolderName String
  bankName              String
}

model Otp {
  id        String   @id @default(cuid())
  email     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ======================================================
// LOG MODELS
// ======================================================

model AccessLog {
  id       String  @id @default(cuid())
  userId   String?
  targetId String?
  action   String
  tag      String? @default("SYSTEM") // e.g. AUTH, APPOINTMENT, ADMIN

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([targetId])
  @@index([tag])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id       String  @id @default(cuid())
  userId   String?
  action   String
  tag      String? @default("SYSTEM") // e.g. AUTH, SECURITY, ONBOARDING
  metadata Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tag])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ======================================================
// DOCTOR REVIEW/COMMENT SYSTEM
// ======================================================

model Rating {
  id       String @id @default(cuid())
  doctorId String
  patientId   String
  rating   Int // 1-5 stars

  // Relations
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, patientId]) // One rating per user per doctor
  @@index([doctorId])
  @@index([patientId])
}

model Comment {
  id       String @id @default(cuid())
  doctorId String
  patientId   String
  text     String // Comment text

  // Relations
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@index([patientId])
  @@index([createdAt])
}


// -----------------------------------------------------------------------------
// Ingestion: immutable versions, page geometry, source hierarchy, structured data
// -----------------------------------------------------------------------------

model MedicalDocumentVersion {
  id                String                @id @default(cuid())
  documentId        String
  document          MedicalDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber     Int
  sourceSha256      String
  schemaVersion     String
  pipelineVersion   String
  configFingerprint String
  tokenizerName     String?
  extractionStatus  MedicalPipelineStatus @default(PENDING)
  indexStatus       MedicalPipelineStatus @default(PENDING)
  isPublished       Boolean               @default(false)
  pageCount         Int                   @default(0)
  objectCount       Int                   @default(0)
  chunkCount        Int                   @default(0)
  issueCount        Int                   @default(0)
  manifest          Json? // full NormalizedDocument metadata (pages/sections/config/issues)
  pipelineMetadata  Json? // provider versions, model choices, budgets, actual capabilities
  contentSha256     String?
  createdAt         DateTime              @default(now())
  publishedAt       DateTime?
  revokedAt         DateTime?
  pages             MedicalDocumentPage[]
  sections          MedicalDocumentSection[]
  objects           MedicalDocumentObject[]
  assets            MedicalDocumentAsset[]
  chunks            MedicalDocumentChunk[]
  observations      MedicalObservation[]
  jobs              MedicalIngestionJob[]
  issues            MedicalExtractionIssue[]

  @@unique([documentId, versionNumber])
  @@index([documentId, isPublished, revokedAt])
  @@index([sourceSha256])
}

model MedicalIngestionJob {
  id               String                @id @default(cuid())
  documentId       String
  document         MedicalDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId        String?
  version          MedicalDocumentVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  generation       Int                   @default(1)
  status           MedicalPipelineStatus @default(QUEUED)
  stage            String                @default("registered")
  attempts         Int                   @default(0)
  availableAt      DateTime              @default(now())
  startedAt        DateTime?
  lastHeartbeatAt  DateTime?
  completedAt      DateTime?
  leaseToken       String?
  leaseOwner       String?
  leaseExpiresAt   DateTime?
  errorCode        String?
  retryable        Boolean               @default(false)
  progress         Json?
  resourceMetrics  Json? // elapsed, peak RSS, provider usage, token counts
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([documentId, generation])
  @@index([status, availableAt])
  @@index([leaseExpiresAt])
}

model MedicalDocumentPage {
  id               String                 @id @default(cuid())
  versionId        String
  version          MedicalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pageNumber       Int
  width            Float
  height           Float
  rotation         Int                    @default(0)
  selectableChars  Int                    @default(0)
  coordinateSystem String                 @default("unrotated_pdf_points")
  cropbox          Json // [x0,y0,x1,y1]
  pdfToPage        Json? // affine transform
  status           MedicalPipelineStatus  @default(COMPLETED)
  metadata         Json? // original validated Page model, warnings, provider IDs
  regions          MedicalObjectRegion[]

  @@unique([versionId, pageNumber])
}

model MedicalDocumentSection {
  id                String                 @id @default(cuid())
  versionId         String
  version           MedicalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sectionStableId   String
  parentSectionId   String?
  title             String
  level             Int
  headingPath       Json // ordered heading strings
  source            Json // exact Search Sphere SourceRef
  readingOrder      Int?

  @@unique([versionId, sectionStableId])
}

model MedicalDocumentObject {
  id             String                 @id @default(cuid())
  versionId      String
  version        MedicalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  objectStableId String
  kind           String // text | table | image | chart | diagram
  subtype        String? // e.g. pie, bar, flowchart; NEVER assume verified
  title          String?
  text           String? // paragraph/native/combined searchable content, as appropriate
  sectionStableId String?
  headingPath    Json? // section ancestry
  firstPage      Int?
  lastPage       Int?
  readingOrder   Int?
  status         MedicalPipelineStatus @default(PARTIAL)
  reviewRequired Boolean              @default(false)
  confidence     Float?
  normalized     Json // ENTIRE validated Paragraph/Table/Visual object, no field loss
  sourceSha256   String?
  createdAt      DateTime             @default(now())
  regions        MedicalObjectRegion[]
  assets         MedicalDocumentAsset[]
  chunkLinks     MedicalChunkObject[]
  observations   MedicalObservation[]

  @@unique([versionId, objectStableId])
  @@index([versionId, kind, firstPage])
  @@index([sectionStableId])
}

model MedicalObjectRegion {
  id                String                @id @default(cuid())
  objectId          String
  object            MedicalDocumentObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  pageId            String
  page              MedicalDocumentPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  regionStableId    String
  parentRegionId    String?
  readingOrder      Int
  coordinateSystem  String
  x0                Float
  y0                Float
  x1                Float
  y1                Float
  sourceImageId     String? // opaque authorized asset ID, not a public URL
  provider          String?
  model             String?
  confidence        Float?
  evidence          Json? // OCR, layout model and source-specific evidence markers
  source            Json // full SourceRef JSON incl. page, bbox, section, offsets

  @@unique([objectId, pageId, regionStableId])
  @@index([pageId, readingOrder])
}

model MedicalDocumentAsset {
  id             String                 @id @default(cuid())
  versionId      String
  version        MedicalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  objectId       String?
  object         MedicalDocumentObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  kind           String // crop, page_preview, diagram_panel, image, etc.
  opaqueAssetId  String
  storagePath    String                 @unique // Quick-Clinic PRIVATE object storage
  mimeType       String
  fileSize       Int
  sha256         String
  pageNumber     Int?
  geometry       Json?
  metadata       Json?
  createdAt      DateTime               @default(now())
  deletedAt      DateTime?

  @@unique([versionId, opaqueAssetId])
  @@index([objectId])
}

model MedicalExtractionIssue {
  id           String                 @id @default(cuid())
  versionId    String
  version      MedicalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pageNumber   Int?
  objectStableId String?
  stage        String
  code         String
  retryable    Boolean               @default(false)
  details      Json? // sanitized diagnostic metadata, no raw credentials
  createdAt    DateTime              @default(now())

  @@index([versionId, stage, pageNumber])
}

// -----------------------------------------------------------------------------
// Retrieval: version-bound chunks, source linkage, pgvector in THIS database
// -----------------------------------------------------------------------------

model MedicalDocumentChunk {
  id                 String                 @id @default(cuid())
  versionId          String
  version            MedicalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunkStableId      String
  chunkIndex         Int
  kind               String // text, table, chart, diagram, image
  content            String
  contentSha256      String
  tokenCount         Int
  tokenizer          String
  headingPath        Json?
  sourceObjectIds    Json // preserve stable source object IDs
  paragraphIds       Json?
  sentenceIds        Json?
  pageNumbers        Json // sorted full page list
  startPage          Int
  endPage            Int
  rowStart           Int?
  rowEnd             Int?
  isFragment         Boolean              @default(false)
  provenance         Json // exact SourceRef list + extraction provenance
  pipelineVersion    String
  status             MedicalPipelineStatus @default(COMPLETED)
  createdAt          DateTime              @default(now())
  sourceLinks        MedicalChunkObject[]
  embeddings         MedicalChunkEmbedding[]
  retrievalHits      AgentRetrievalHit[]
  observations       MedicalObservation[]

  @@unique([versionId, chunkStableId])
  @@unique([versionId, chunkIndex])
  @@index([versionId, kind, startPage])
  @@index([contentSha256])
}

model MedicalChunkObject {
  id          String                 @id @default(cuid())
  chunkId     String
  chunk       MedicalDocumentChunk   @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  objectId    String
  object      MedicalDocumentObject  @relation(fields: [objectId], references: [id], onDelete: Cascade)
  sourceRefs  Json? // page boxes, sentence offsets, cell/row ranges
  createdAt   DateTime               @default(now())

  @@unique([chunkId, objectId])
  @@index([objectId])
}

model MedicalChunkEmbedding {
  id               String                @id @default(cuid())
  chunkId          String
  chunk            MedicalDocumentChunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  vectorId         String                @unique // stable search/index identity
  provider         String
  model            String
  dimension        Int                   @default(384)
  embeddingVersion String
  indexGeneration  Int                   @default(1)
  inputSha256      String
  status           MedicalPipelineStatus @default(PENDING)
  embedding        Unsupported("vector(384)")? // pgvector: created via SQL migration
  embeddingMetadata Json?
  indexedAt        DateTime?
  createdAt        DateTime              @default(now())

  @@unique([chunkId, model, embeddingVersion])
  @@index([status, model, dimension])
}

model MedicalObservation {
  id                  String                 @id @default(cuid())
  patientId           String
  patient             Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  versionId           String
  version             MedicalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  objectId            String?
  object              MedicalDocumentObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  chunkId             String?
  chunk               MedicalDocumentChunk?  @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  observationType     String
  displayName         String
  valueNumeric        Float?
  valueSecondaryNumeric Float?
  valueText           String?
  unit                String?
  referenceRange      Json?
  observedAt          DateTime?
  reportedAt          DateTime?
  dateInferred        Boolean                @default(false)
  pageNumber          Int?
  extractionMethod    String
  confidence          Float?
  reviewStatus        String                 @default("UNREVIEWED")
  source              Json // values/cells/page/region/ocr evidence
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([patientId, observationType, observedAt])
  @@index([versionId, pageNumber])
}

// -----------------------------------------------------------------------------
// Patient authorization, explicit grants/revocation, storage cleanup
// -----------------------------------------------------------------------------

model MedicalAccessGrant {
  id               String            @id @default(cuid())
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  documentId       String?
  document         MedicalDocument?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  grantedByUserId  String
  grantedBy        User              @relation("MedicalGrantCreator", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  relationshipAppointmentId String?
  scope            Json // document/category and permitted operations; never trust without auth
  consentSource    String
  policyVersion    Int               @default(1)
  effectiveAt      DateTime          @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([doctorId, patientId, revokedAt, expiresAt])
  @@index([documentId])
}

model MedicalDocumentCleanup {
  id           String           @id @default(cuid())
  documentId   String?
  document     MedicalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentIdSnapshot String
  storagePath  String // opaque private storage key; no extracted PHI
  status       String           @default("QUEUED")
  attempts     Int              @default(0)
  availableAt  DateTime         @default(now())
  leaseToken   String?
  leaseExpiresAt DateTime?
  lastErrorCode String?
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  @@index([status, availableAt])
  @@index([documentIdSnapshot])
}

// -----------------------------------------------------------------------------
// Agent: exact Q/A, scoped history, memory, tool and retrieval provenance
// -----------------------------------------------------------------------------

model AgentThread {
  id                  String            @id @default(cuid()) // stable LangGraph thread_id
  ownerUserId         String
  owner               User              @relation("AgentThreadOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  doctorId            String?
  doctor              Doctor?           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId           String?
  patient             Patient?          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scopeType           String            @default("GENERAL") // GENERAL or SINGLE_PATIENT
  purpose             String            @default("CLINIC_ASSISTANT")
  title               String            @default("New conversation")
  status              AgentThreadStatus @default(ACTIVE)
  permissionRevision  Int               @default(1)
  latestMemoryVersion Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lastMessageAt       DateTime?
  redactedAt          DateTime?
  messages            AgentMessage[]
  turns               AgentTurn[]
  memories            AgentMemorySnapshot[]
  approvals           AgentApproval[]
  toolCalls           AgentToolCall[]
  providerCalls       AgentModelCall[]

  @@index([ownerUserId, status, updatedAt])
  @@index([doctorId, patientId])
}

model AgentTurn {
  id                 String       @id @default(cuid())
  threadId           String
  thread             AgentThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  turnIndex          Int
  originalQuery      String
  retrievalQuery     String?
  rewritten          Boolean      @default(false)
  requiresHistory    Boolean      @default(false)
  queryRoute         String? // DIRECT, RAG, CLARIFICATION, etc.
  queryPolicyVersion String?
  classification     Json?
  plannedTools       Json?
  status             String       @default("RUNNING")
  responseHash       String?
  startedAt          DateTime     @default(now())
  completedAt        DateTime?
  messages           AgentMessage[]
  contextLinks       AgentContextLink[]
  retrievalRuns      AgentRetrievalRun[]
  toolCalls          AgentToolCall[]
  providerCalls      AgentModelCall[]

  @@unique([threadId, turnIndex])
  @@index([threadId, startedAt])
}

model AgentMessage {
  id           String             @id @default(cuid())
  threadId     String
  thread       AgentThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  turnId       String?
  turn         AgentTurn?         @relation(fields: [turnId], references: [id], onDelete: SetNull)
  sequence     Int
  role         AgentMessageRole
  status       AgentMessageStatus @default(COMPLETED)
  content      String // original Q / assistant answer / safe tool message
  contentSha256 String?
  messageMetadata Json? // API request IDs, versions, app display info, token counts
  createdAt    DateTime           @default(now())
  redactedAt   DateTime?
  redactionReason String?
  citations    AgentMessageCitation[]
  usedAsContext AgentContextLink[]

  @@unique([threadId, sequence])
  @@index([turnId, createdAt])
  @@index([threadId, createdAt])
}

model AgentContextLink {
  id           String       @id @default(cuid())
  turnId       String
  turn         AgentTurn    @relation(fields: [turnId], references: [id], onDelete: Cascade)
  messageId    String
  message      AgentMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reason       String // recent_window, semantic_memory, previous_answer_reference
  orderIndex   Int
  permissionRevision Int
  includedAt   DateTime     @default(now())

  @@unique([turnId, messageId])
  @@index([messageId])
}

model AgentMemorySnapshot {
  id                  String       @id @default(cuid())
  threadId            String
  thread              AgentThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  version             Int
  summary             String
  summarySha256       String
  coveredMessageIds   Json // exact past messages summarized
  sourceChunkIds      Json? // linked chunk/version IDs, not PHI copies
  topics              Json?
  latestMessageId     String?
  tokenCount          Int          @default(0)
  summarizerModel     String?
  permissionRevision  Int
  authorizationHash   String?
  createdAt           DateTime     @default(now())
  invalidatedAt       DateTime?
  invalidationReason  String?

  @@unique([threadId, version])
  @@index([threadId, invalidatedAt])
}

model AgentRetrievalRun {
  id             String              @id @default(cuid())
  turnId         String
  turn           AgentTurn           @relation(fields: [turnId], references: [id], onDelete: Cascade)
  query          String
  strategy       String // dense, sparse, hybrid, observation, exact_prior_chunk
  queryFilters   Json?
  indexVersion   String?
  embeddingModel String?
  rerankerModel  String?
  topK           Int
  candidateCount Int                   @default(0)
  selectedCount  Int                   @default(0)
  authorizationHash String?
  status         String                @default("RUNNING")
  durationMs     Int?
  metrics        Json? // scores, cache hit, tokenizer, retrieval config
  createdAt      DateTime              @default(now())
  hits           AgentRetrievalHit[]

  @@index([turnId, createdAt])
}

model AgentRetrievalHit {
  id             String                @id @default(cuid())
  retrievalRunId String
  retrievalRun   AgentRetrievalRun     @relation(fields: [retrievalRunId], references: [id], onDelete: Cascade)
  chunkId        String?
  chunk          MedicalDocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  chunkStableId  String // historical stable ID; authorization checked before use
  versionStableId String?
  sourceObjectIds Json?
  sourceRefs     Json? // page numbers / bboxes / source evidence references
  contentSha256  String
  candidateRank  Int
  finalRank      Int?
  denseScore     Float?
  sparseScore    Float?
  hybridScore    Float?
  rerankScore    Float?
  includedInPrompt Boolean @default(false)
  citedInAnswer  Boolean @default(false)
  reviewRequired Boolean @default(false)
  authorizedAtRetrieval Boolean @default(false)
  excludedReason String?
  createdAt      DateTime              @default(now())
  citations      AgentMessageCitation[]

  @@unique([retrievalRunId, candidateRank])
  @@index([chunkId])
}

model AgentMessageCitation {
  id                  String              @id @default(cuid())
  messageId           String
  message             AgentMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  retrievalHitId      String?
  retrievalHit        AgentRetrievalHit?  @relation(fields: [retrievalHitId], references: [id], onDelete: SetNull)
  label               String
  claimSpan           Json? // answer character range or quote range
  chunkStableId       String?
  documentVersionId   String?
  sourceObjectId      String?
  pageNumber          Int?
  sourceRefs          Json? // crop/rectangle/page, reviewed confidence
  contentSha256       String?
  reviewRequired      Boolean             @default(false)
  revokedAt           DateTime?
  createdAt           DateTime            @default(now())

  @@index([messageId])
  @@index([chunkStableId])
  @@index([documentVersionId])
}

model AgentToolCall {
  id             String       @id @default(cuid())
  threadId       String
  thread         AgentThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  turnId         String
  turn           AgentTurn    @relation(fields: [turnId], references: [id], onDelete: Cascade)
  toolCallId     String
  toolName       String
  actionType     String?
  riskLevel      String?
  inputJson      Json // validated, scoped arguments; never trust LLM IDs
  inputSha256    String
  resultJson     Json? // sanitized, authorized, bounded output only
  resultSha256   String?
  status         String       @default("PROPOSED")
  approvalId     String?      @unique
  approval       AgentApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  errorCode      String?
  durationMs     Int?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?

  @@unique([threadId, toolCallId])
  @@index([turnId, startedAt])
  @@index([status])
}

model AgentModelCall {
  id             String      @id @default(cuid())
  threadId       String
  thread         AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  turnId         String?
  turn           AgentTurn?  @relation(fields: [turnId], references: [id], onDelete: SetNull)
  purpose        String // answer, rewrite, classification, embedding, vision, rerank
  provider       String
  model          String
  modelVersion   String?
  promptVersion  String?
  requestSha256  String?
  responseSha256 String?
  promptTokens   Int?
  completionTokens Int?
  totalTokens    Int?
  latencyMs      Int?
  providerRequestId String?
  traceId        String?
  retryCount     Int          @default(0)
  fallbackFrom   String?
  privacyPolicyRef String?
  status         String       @default("RUNNING")
  errorCode      String?
  usageMetadata  Json?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@index([threadId, createdAt])
  @@index([provider, model, createdAt])
}

// -----------------------------------------------------------------------------
// Human approval: durable 60-second proposal and separate execution state
// -----------------------------------------------------------------------------

model AgentApproval {
  id               String               @id @default(cuid())
  threadId         String
  thread           AgentThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  toolCallId       String
  requestedByUserId String
  requestedBy      User                 @relation("AgentApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId String?
  decidedBy        User?                @relation("AgentApprovalDecider", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  actionType       String
  riskLevel        AgentActionRiskLevel
  title            String
  summary          String
  reason           String
  parameters       Json
  payloadHash      String
  idempotencyKey   String               @unique
  status           AgentApprovalStatus  @default(PENDING)
  executionStatus  AgentExecutionStatus @default(NOT_STARTED)
  createdAt        DateTime             @default(now())
  expiresAt        DateTime
  decidedAt        DateTime?
  decisionReason   String?
  executedAt       DateTime?
  completedAt      DateTime?
  executionResult  Json? // safe non-PHI outcome code and affected IDs
  executionLeaseExpiresAt DateTime?
  executionAttempts Int                 @default(0)
  lastErrorCode     String?
  updatedAt        DateTime             @updatedAt
  toolInvocation   AgentToolCall?

  @@unique([threadId, toolCallId])
  @@index([requestedByUserId, status, expiresAt])
  @@index([status, executionStatus])
  @@index([executionStatus, executionLeaseExpiresAt])
}

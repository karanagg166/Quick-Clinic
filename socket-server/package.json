{
  "name": "quickclinic-socket-server",
  "version": "1.0.0",
  "description": "Socket.IO server for QuickClinic real-time chat",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node main.ts",
    "dev:watch": "nodemon --exec ts-node main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@10.33.0",
  "keywords": [
    "socket.io",
    "websocket",
    "chat",
    "real-time"
  ],
  "author": "Karan Aggarwal",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@prisma/client-runtime-utils": "7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/formidable": "^3.4.6",
    "@types/node": "^20.19.26",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}

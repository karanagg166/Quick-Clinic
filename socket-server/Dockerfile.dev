# Development Dockerfile for Socket Server
FROM node:24-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Enable and configure pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy root package.json and lockfile (for Prisma client dependencies)
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install

# Copy socket-server package files
COPY socket-server/package.json socket-server/pnpm-lock.yaml* ./socket-server/
RUN cd socket-server && pnpm install

# Copy Prisma schema and generate client
COPY prisma ./prisma/
COPY prisma.config.ts ./
RUN pnpm dlx prisma generate

# Copy socket server files
COPY socket-server ./socket-server/

# Expose port
EXPOSE 4000

ENV NODE_ENV=development
ENV PORT=4000

# Start in development mode with watch
WORKDIR /app/socket-server
CMD ["pnpm", "run", "dev"]

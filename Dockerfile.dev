# Base image — use Debian slim (not Alpine) so Next.js 16 Turbopack
# native SWC bindings work (they require glibc, which Alpine lacks)
FROM node:24-slim

WORKDIR /app

# Accept a build-time argument
ARG NODE_ENV=development
ENV NODE_ENV=${NODE_ENV}

# Prisma needs openssl
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Enable and configure pnpm
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Install dependencies using pnpm
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy project files
COPY . .

# Generate Prisma Client
RUN pnpm exec prisma generate

# 👉 Run build ONLY in production
RUN if [ "$NODE_ENV" = "production" ] ; then pnpm run build ; fi

EXPOSE 3000

# Start dev mode by default
CMD ["pnpm", "run", "dev"]

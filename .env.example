# Existing PostgreSQL database. No schema/data changes run at application startup.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
CRON_SECRET="replace-with-a-random-cron-secret"
SUPER_ADMIN_CODE=""

# Next.js proxies /api to the unified backend. The browser connects Socket.IO directly.
BACKEND_URL="http://localhost:4000"
BACKEND_PUBLIC_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
# Optional distributed rate limiting and Socket.IO room fanout.
REDIS_URL=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
OPENROUTESERVICE_API_KEY=""

# Local development uses private disk. Free Render uses authenticated Cloudinary raw storage.
DOCUMENT_STORAGE_BACKEND="local"
DOCUMENT_STORAGE_DIR="./data/medical-documents"
NODE_ENV="development"

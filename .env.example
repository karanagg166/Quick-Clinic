###################################
# DATABASE (Neon PostgreSQL)
###################################
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&channel_binding=require"

###################################
# UPSTASH REDIS (REST API)
###################################
# REST API URL for Upstash Redis (used for slot holds and distributed caching)
UPSTASH_REDIS_REST_URL="https://your-upstash-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"

###################################
# REDIS CLIENT (Optional Redis URL)
###################################
# Redis protocol URL (ioredis / socket-server)
REDIS_URL="rediss://default:YOUR_PASSWORD@your-upstash-id.upstash.io:6379"

###################################
# MAPS & ROUTING (OpenRouteService)
###################################
# Server-only OpenRouteService key for nearby-doctor driving distance and ETA calculation
OPENROUTESERVICE_API_KEY=""

###################################
# AUTH & SECURITY
###################################
# Secret for signing JWT session tokens (at least 32 characters)
JWT_SECRET="your-super-secret-jwt-token-key-at-least-32-chars"
# Secret for cron job verification (/api/cron/expire-appointments)
CRON_SECRET="your-secure-cron-secret-token"
# Optional super admin onboarding code (defaults to QUICK_CLINIC_SUPER_ADMIN)
SUPER_ADMIN_CODE="QUICK_CLINIC_SUPER_ADMIN"

###################################
# SOCKET SERVER & REALTIME
###################################
# Socket server URL for client connection
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
# Frontend URL for Socket.IO CORS (used by socket-server)
FRONTEND_URL="http://localhost:3000"

###################################
# PAYMENTS (Razorpay)
###################################
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

###################################
# CLOUDINARY (Avatar / Image Uploads)
###################################
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

###################################
# RESEND (Email / OTP Notifications)
###################################
RESEND_API_KEY="re_..."
RESEND_FROM="onboarding@resend.dev"

###################################
# NODE ENVIRONMENT
###################################
NODE_ENV="development"


# Dedicated Quick-Clinic Supabase PostgreSQL session-pooler connection.
# No schema/data changes run at application startup.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
CRON_SECRET="replace-with-a-random-cron-secret"
SUPER_ADMIN_CODE=""

# Next.js proxies /api to the unified backend. The browser connects Socket.IO directly.
BACKEND_URL="http://localhost:4000"
BACKEND_PUBLIC_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
# Optional distributed rate limiting and Socket.IO room fanout.
REDIS_URL=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"
SUPABASE_URL="https://yrrcjcddrmkercetjfhl.supabase.co"
# Backend-only secret key; never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
SUPABASE_DOCUMENT_BUCKET="quick-clinic-medical-documents"
SUPABASE_AVATAR_BUCKET="quick-clinic-avatars"
OPENROUTESERVICE_API_KEY=""

# Local development uses private disk. Free Render uses private Supabase object storage.
DOCUMENT_STORAGE_BACKEND="local"
DOCUMENT_STORAGE_DIR="./data/medical-documents"
NODE_ENV="development"

# AI & LLM Model Providers
GOOGLE_API_KEY=""
GROQ_API_KEY=""
COHERE_API_KEY=""

# LangChain & LangSmith Observability
LANGSMITH_TRACING=""
LANGSMITH_ENDPOINT=""
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""
LANGCHAIN_TRACING_V2=""
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=""
